{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "SID BrainMRI Training",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/sid_train.py",
        "console": "integratedTerminal",
        "args": [
          "--outdir=/blob/v-tianyuchen/Projects/Ambient_A/mri/sid_brainMRI_R=2",
          "--experiment_name=sid_brainMRI_R=2",
          "--dump=50",
          "--cond=0",
          "--arch=ddpmpp",
          "--precond=ambient",
          "--cres=1,1,1,1",
          "--lr=1e-5",
          "--dropout=0.1",
          "--augment=0",
          "--data=/blob/v-tianyuchen/Projects/Ambient_A/mri/mri_data_numpy.zip",
          "--norm=2",
          "--max_grad_norm=1.0",
          "--mask_full_rgb=1",
          "--corruption_probability=2",
          "--delta_probability=3",
          "--batch=64",
          "--normalize=0",
          "--fp16=1",
          "--edm_model=/blob/v-tianyuchen/Projects/Ambient_A/mri/R=2/network-snapshot.pkl",
          "--batch-gpu=1",
          "--glr=1e-5",
          "--g_beta1=0.0",
          "--alpha=1.2",
          "--tmax",
          "800",
          "--init_sigma",
          "2.5",
          "--tick",
          "10",
          "--snap",
          "50",
          "--lsg",
          "100"
        ],
        "env": {
          "CUDA_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7"
        },
      }
    ]
  }
  